<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
          A dedicated MySQL/MariaDB database, NOT sqlite. Two historical
          migrations are MySQL-only and must not be edited (see
          .claude/rules/database.md): 2024_01_01_100003 uses fullText(), which
          the SQLite grammar rejects outright, and 2026_07_12_000004 issues a
          raw ALTER TABLE ... ADD CONSTRAINT that SQLite cannot execute.
          The database name is deliberately distinct from the development
          database so RefreshDatabase can never truncate real data.
        -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="gamepek_rental_test"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PAYMENT_GATEWAY" value="mock"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
