APP_NAME="GamePek"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=Asia/Tehran
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gamepek
DB_USERNAME=gamepek_user
DB_PASSWORD=gamepek_pass

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=gamepek_

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@gamepek.ir"
MAIL_FROM_NAME="${APP_NAME}"

# ============================================================
# GamePek OTP Settings
# ============================================================
OTP_SHOW_IN_DEV=true
OTP_LENGTH=5
AUTH_OTP_EXPIRY_MINUTES=2
AUTH_OTP_RATE_LIMIT=5
AUTH_OTP_RATE_LIMIT_DECAY_MINUTES=15

# MeliPayamak OTP (sole OTP delivery channel)
MELIPAYAMAK_API_KEY=
MELIPAYAMAK_ENDPOINT=https://console.melipayamak.com/api/send/otp
MELIPAYAMAK_TIMEOUT=10

# ============================================================
# Payment Gateway (mock for dev; replace for production)
# ============================================================
PAYMENT_GATEWAY=mock
PAYMENT_CALLBACK_URL="${APP_URL}/payment/callback"
# Zarinpal (example for production)
ZARINPAL_MERCHANT_ID=
# IDPay (example)
IDPAY_API_KEY=
# Pardakht Novin IPG (NormalSale/Confirm/Reverse -- see docs I.P.IT.012.00)
PARDKHTNOVIN_CORPORATION_PIN=
PARDKHTNOVIN_TERMINAL_ID=
PARDKHTNOVIN_MERCHANT_ID=
PARDKHTNOVIN_CALLBACK_URL="${APP_URL}/payment/callback"
PARDKHTNOVIN_SANDBOX=false

# ============================================================
# Upload / Storage
# ============================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
