###############################################################################
# GamePek RENTAL — environment template
#
# This is the RENTAL application. The GamePek Store is a SEPARATE application
# with a SEPARATE database. Never point this file at the Store.
#
#   Rental database : gamepek_rental   <-- this app
#   Store database  : gamepek          <-- DO NOT USE HERE
#
# APP_NAME is deliberately "GamePek Rental": Laravel derives the session cookie
# name and the cache prefix from it, so a shared name would let the two apps
# collide on a shared host or cache store.
###############################################################################

APP_NAME="GamePek Rental"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=Asia/Tehran
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ============================================================
# Database — RENTAL ONLY
# ============================================================
# Must be gamepek_rental. The Store's `gamepek` database must never be
# reachable from this application.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gamepek_rental
DB_USERNAME=root
DB_PASSWORD=

# Test suite runs against a dedicated database (see phpunit.xml). It is kept
# distinct from the development database so RefreshDatabase can never truncate
# real data. MySQL/MariaDB only — two historical migrations are not SQLite
# compatible.
#   CREATE DATABASE gamepek_rental_test CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;

# ============================================================
# Session / cache / queue
# ============================================================
# Laravel 11 slim skeleton: there is no config/session.php, config/cache.php or
# config/database.php in this repo. These are framework defaults driven purely
# by the variables below.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
# Distinct from the Store's prefix so a shared cache store cannot collide.
CACHE_PREFIX=gamepek_rental_

QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

# ============================================================
# Filesystem / storage
# ============================================================
FILESYSTEM_DISK=local

# On the production host the document root sits ABOVE the Laravel root, so
# uploads must be written to the served storage/ directory or Apache will never
# see them. Leave empty locally to fall back to public/storage.
STORAGE_PUBLIC_PATH=

# Private disk path for verification media (identity photos, liveness and
# handover/return video). Never the public disk.
VERIFICATION_STORAGE_PATH=

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@gamepek.ir"
MAIL_FROM_NAME="${APP_NAME}"

# ============================================================
# Login OTP
# ============================================================
# Separate channel from the general rental SMS seam below, and separate again
# from the contract signing OTP (which has its own table and rate limiter).
OTP_SHOW_IN_DEV=true
OTP_LENGTH=5
AUTH_OTP_EXPIRY_MINUTES=2
AUTH_OTP_RATE_LIMIT=5
AUTH_OTP_RATE_LIMIT_DECAY_MINUTES=15

# MeliPayamak — sole OTP delivery channel. UNCONFIGURED: with an empty API key
# the NullOtpProvider delivers the code to the log in local so login still
# works; no real SMS is sent.
MELIPAYAMAK_API_KEY=
MELIPAYAMAK_ENDPOINT=https://console.melipayamak.com/api/send/otp
MELIPAYAMAK_TIMEOUT=10

# ============================================================
# Payment
# ============================================================
# MOCK ONLY. No live gateway is connected to Rental.
# GatewayRegistry makes `mock` unresolvable outside local/testing, so a typo
# here cannot run the mock gateway in production.
PAYMENT_GATEWAY=mock
PAYMENT_CALLBACK_URL="${APP_URL}/payment/callback"

PAYMENT_RECONCILE_STALE_MINUTES=30
PAYMENT_RECONCILE_LOOKBACK_HOURS=72

# Pardakht Novin IPG (NormalSale/Confirm/Reverse, docs I.P.IT.012.00).
# Adapter is implemented and registered, but UNCONFIGURED: no rental merchant
# credentials have been issued. Do not wire until the owner confirms them.
PARDKHTNOVIN_CORPORATION_PIN=
PARDKHTNOVIN_TERMINAL_ID=
PARDKHTNOVIN_MERCHANT_ID=
PARDKHTNOVIN_CALLBACK_URL="${APP_URL}/payment/callback"
PARDKHTNOVIN_SANDBOX=false

# Zarinpal / IDPay are read by config/services.php but are NOT registered in
# config('rental.payment.gateways'). They were never implemented for Rental and
# resolve to UnconfiguredGateway, which fails closed. Left here only so the
# config keys resolve; setting them does not enable a gateway.
ZARINPAL_MERCHANT_ID=
ZARINPAL_CALLBACK_URL=
ZARINPAL_SANDBOX=true
IDPAY_API_KEY=
IDPAY_CALLBACK_URL=
IDPAY_SANDBOX=true

# ============================================================
# Verification providers — ALL CURRENTLY FAKE / UNCONFIGURED
# ============================================================
# Driver rules (App\Providers\IntegrationServiceProvider):
#   - a driver with no registered adapter resolves to the Unconfigured provider,
#     which THROWS. It never silently falls back to a fake.
#   - the `fake` driver is refused outside local/testing.
# No vendor has been selected for any of these. base_url and credentials are
# intentionally blank — no endpoint or tariff has been invented.

# Identity: Shahkar, civil registry, liveness, face match
IDENTITY_DRIVER=fake
IDENTITY_ENV=sandbox
IDENTITY_BASE_URL=
IDENTITY_API_KEY=
IDENTITY_API_SECRET=
IDENTITY_WEBHOOK_SECRET=

# Bank account ownership: card / IBAN holder match
BANK_OWNERSHIP_DRIVER=fake
BANK_OWNERSHIP_ENV=sandbox
BANK_OWNERSHIP_BASE_URL=
BANK_OWNERSHIP_API_KEY=
BANK_OWNERSHIP_API_SECRET=

# Guarantee: Sayad cheque inquiries
GUARANTEE_DRIVER=fake
GUARANTEE_ENV=sandbox
GUARANTEE_BASE_URL=
GUARANTEE_API_KEY=
GUARANTEE_API_SECRET=
# The published Sayad check-digit rule is implemented but disabled: no bank
# specification is available here to confirm it, and rejecting a genuine cheque
# on an unverified checksum is worse than letting the provider reject it.
GUARANTEE_ENFORCE_SAYAD_CHECKSUM=false

# Contract signature. `internal` = HMAC over the contract content hash plus
# signer and timestamp, with SMS OTP as the signer challenge.
# This is NOT PKI and carries no established legal weight — see docs.
SIGNATURE_DRIVER=internal
SIGNATURE_ENV=sandbox
SIGNATURE_BASE_URL=

# Verification media access
VERIFICATION_SIGNED_URL_MINUTES=10

###############################################################################
# DANGER — NEVER SET THESE IN PRODUCTION
#
# VERIFICATION_IDENTITY_REQUIRED_CHECKS
# VERIFICATION_GUARANTEE_REQUIRED_INQUIRIES
#
# These exist ONLY so the automated path can be exercised end to end in local
# testing. They are NOT owner-approved policy (business decisions B1 / B6).
# Setting either in production auto-verifies real people's identities and real
# cheque guarantees on a guess.
#
# The shipped default is empty, which is fail-closed: nothing auto-verifies and
# everything waits for an admin. Keep it that way. Example for LOCAL ONLY:
#   VERIFICATION_IDENTITY_REQUIRED_CHECKS=shahkar,civil_registry
#   VERIFICATION_GUARANTEE_REQUIRED_INQUIRIES=sayad_validate,ownership_match
###############################################################################
VERIFICATION_IDENTITY_REQUIRED_CHECKS=
VERIFICATION_GUARANTEE_REQUIRED_INQUIRIES=

# ============================================================
# Rental lifecycle SMS — UNCONFIGURED
# ============================================================
# Separate seam from login OTP. No provider selected and no approved message
# copy exists (business decision B13), so config('rental.sms.templates') is
# empty and nothing is ever sent. Default driver is `log` outside production and
# `unconfigured` in production, which fails loudly rather than pretending.
# Empty = `log` in local/testing (writes to the log, sends nothing) and
# `unconfigured` everywhere else (every send fails honestly). `log` is refused
# outside local/testing even if set here. No real provider is integrated yet.
SMS_DRIVER=
SMS_ENV=sandbox
SMS_BASE_URL=
SMS_API_KEY=
SMS_API_SECRET=
RENTAL_SMS_MAX_ATTEMPTS=3

# ============================================================
# Rental behaviour
# ============================================================
# Which contract_templates key ContractService::generate() renders.
RENTAL_CONTRACT_TEMPLATE_KEY=rental_agreement

# Reservation hold expiry. Deliberately EMPTY (business decision B10): with no
# value, holds never auto-expire and the expiry sweep no-ops, so a customer's
# reservation is never dropped on a guessed timeout.
RENTAL_HOLD_MINUTES=

# ============================================================
# Optional third-party services (unused by Rental today)
# ============================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net
POSTMARK_TOKEN=
